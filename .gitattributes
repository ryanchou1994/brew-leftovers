# Line endings: text files are stored with LF in the repo and checked out with LF on every system.
# Overrides core.autocrlf (true by default in Git for Windows) and normalizes CRLF written by tools on commit.
* text=auto eol=lf

# Binary files: no line-ending conversion, no text diff.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.mp4   binary
*.webm  binary
*.mov   binary
*.mp3   binary
*.wav   binary
*.zip   binary
*.gz    binary
*.pdf   binary
